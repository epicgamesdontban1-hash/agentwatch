# Copy this file to `.env` for local development. Never commit your real `.env` (it is gitignored).
# On Render, set these as environment variables in the dashboard instead.

PORT=3000
HOST=0.0.0.0

# Optional shared secret. If set, mod clients must include this token in their `register` message.
# Leave empty for an open deployment (fine for a public dashboard).
# MOD_TOKEN=change-me-to-a-long-random-string

# How long without a heartbeat before a session is declared stale/offline.
HEARTBEAT_TIMEOUT_MS=45000
# How often the stale-session sweep runs.
STALE_SWEEP_MS=10000
# Fully-disconnected sessions are reaped after this many milliseconds.
REMOVE_AFTER_MS=600000

# Size guards (prevent a single misbehaving client from exhausting memory).
MAX_SESSIONS=500
MAX_PLAYERS_PER_SESSION=2000
MAX_CHAT_HISTORY=200
MAX_CHAT_LENGTH=512

# CORS for the website. Use "*" to allow any origin, or lock it to your site:
# CORS_ORIGIN=https://your-site.example
CORS_ORIGIN=*

# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
